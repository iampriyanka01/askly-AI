# Copy to .env and fill in. Askly runs without any keys (offline: BM25 + extractive answers).

# ---- LLM backbone: "auto" picks Gemini if GOOGLE_API_KEY is set, else OpenAI ----
# You need ONE of these two keys (or none, for offline mode):
#   Gemini (free tier):  https://aistudio.google.com/app/apikey  -> "Create API key"
#   OpenAI (paid):       https://platform.openai.com/api-keys     -> "Create new secret key" (add billing first)
LLM_PROVIDER=auto
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Blank = provider default (gemini-3.5-flash-lite / gpt-4o-mini)
LLM_MODEL=
# Free tiers are ~5 requests/minute; raise this on a paid key for faster answers
LLM_REQUESTS_PER_MINUTE=5

# ---- Embeddings (blank = gemini-embedding-001 / text-embedding-3-small) ----
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=768

# ---- Dense vector store: faiss (local, default) or pinecone ----
VECTOR_BACKEND=faiss
# Optional, only with VECTOR_BACKEND=pinecone:
#   https://app.pinecone.io/organizations/-/projects -> your project -> API keys -> "+ API key"
PINECONE_API_KEY=
PINECONE_INDEX_NAME=askly
PINECONE_NAMESPACE=knowledge_base

# ---- Retrieval ----
RETRIEVAL_TOP_K=12
RERANK_TOP_N=4
# auto = cross-encoder if RERANKER_MODEL is set, else lexical | llm = one extra LLM call per question
RERANKER=auto
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   (pip install sentence-transformers)

# Relevance (0-1) below which Askly says "not in the docs" and offers escalation
GAP_THRESHOLD=0.35
MAX_HISTORY_TURNS=6

# ---- Organisation ----
# Blank = detected from the documents (e.g. "Orion Digital Services")
COMPANY_NAME=
